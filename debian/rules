#!/usr/bin/make -f

# Build the spiflash Python package with dh-python/pybuild straight from
# pyproject.toml (hatchling backend). The upstream version is normally derived
# from git by hatch-vcs, but during the .deb build there may be no VCS context
# in the unpacked source, so we pin it to the changelog version through
# SETUPTOOLS_SCM_PRETEND_VERSION. The changelog is written by each build
# (mithro/apt-repo-action's scripts/deb-version.py): X.Y[.postN], then ~deb<R>
# for the suite and ~pr<P> for a pull request preview. Those suffixes aren't
# PEP 440, so the Python version is the part before the first "~": the same
# X.Y[.postN] the wheel on PyPI carries. dpkg source format is native, so there
# is no Debian revision to strip.
export PYBUILD_NAME = spiflash
export SETUPTOOLS_SCM_PRETEND_VERSION = $(firstword $(subst ~, ,$(shell dpkg-parsechangelog -SVersion)))

# The tests run against the built package (its data files included), with
# tools/ on the path for the extractor tests. pytest-cov is not a build
# dependency, so pyproject's coverage options are cleared; test_update_db.py
# is left to CI, as it drives git.
export PYBUILD_TEST_CUSTOM = 1
export PYBUILD_TEST_ARGS = cd {dir} && PYTHONPATH={build_dir}:{dir}/tools {interpreter} -m pytest -q -p no:cacheprovider -o addopts= tests/test_db.py tests/test_cli.py tests/test_cparse.py tests/test_extract.py

%:
	dh $@ --with python3 --buildsystem=pybuild
